NODE_ENV=development
PORT=10000
# Generate at least 32 cryptographically random bytes; never commit the value.
JWT_SECRET=
MONGODB_URI=
# Required HTTPS canonical origin in production; no trailing slash.
APP_ORIGIN=http://localhost:10000
# Set 1 only behind one trusted reverse proxy. Default 0.
TRUST_PROXY_HOPS=0
LOG_LEVEL=INFO
ENABLE_ANONYMOUS_SCANS=false
# Requires verified network-level isolation against private/metadata networks and DNS rebinding.
CRAWLER_EGRESS_ISOLATED=false
PAGESPEED_API_KEY=
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Comma-separated exact administrator emails; no default administrator.
ADMIN_EMAILS=
# Optional free, read-only Google Search Console connection. Disabled until configured.
GSC_ENABLED=false
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
# Generate separately with: openssl rand -base64 32. Keep stable and back up securely.
GSC_TOKEN_ENCRYPTION_KEY=

# Premium release is sandbox-only. No live billing is implemented.
BILLING_MODE=disabled
PREMIUM_STORAGE_READY=false
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_PRO_PRICE_ID=
PADDLE_AGENCY_PRICE_ID=
AI_DRAFTS_ENABLED=false
# New AI entry point only; legacy aiService remains disabled.
OPENROUTER_API_KEY=
AI_DRAFT_MODEL=
AI_DRAFT_PROVIDER=
AI_MONTHLY_BUDGET_USD=10
AI_USER_MONTHLY_BUDGET_USD=1
AI_MAX_REQUEST_USD=0.01
# Explicit verified USD/million token ceilings; missing values fail closed.
AI_MAX_PROMPT_USD_PER_MILLION=
AI_MAX_COMPLETION_USD_PER_MILLION=
