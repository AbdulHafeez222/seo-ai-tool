NODE_ENV=development
PORT=10000
# Generate at least 32 cryptographically random bytes; never commit the value.
JWT_SECRET=
MONGODB_URI=
# Required HTTPS canonical origin in production; no trailing slash.
APP_ORIGIN=http://localhost:10000
# Set 1 only behind one trusted reverse proxy. Default 0.
TRUST_PROXY_HOPS=0
LOG_LEVEL=INFO
ENABLE_ANONYMOUS_SCANS=false
# Requires verified network-level isolation against private/metadata networks and DNS rebinding.
CRAWLER_EGRESS_ISOLATED=false
PAGESPEED_API_KEY=
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Comma-separated exact administrator emails; no default administrator.
ADMIN_EMAILS=
